  }
];

function slugify(str){
  return str.normalize('NFD').replace(/[\u0300-\u036f]/g,'')
    .replace(/đ/g,'d').replace(/Đ/g,'D')
    .toLowerCase().trim()
    .replace(/[^a-z0-9\s-]/g,'')
    .replace(/\s+/g,'-').replace(/-+/g,'-');
}

marked.setOptions({
  highlight: function(code, lang){
    const language = hljs.getLanguage(lang) ? lang : 'plaintext';
    return hljs.highlight(code, { language }).value;
  },
  langPrefix: 'hljs language-'
});

let posts = null;
async function loadPosts(){
  if(posts) return posts;
  try{
    const doc = await POSTS_DOC.get();
    posts = (doc.exists && Array.isArray(doc.data().items)) ? doc.data().items : [];
  }catch(e){
    console.error('Không đọc được Firestore:', e);
    posts = [];
  }
  if(!Array.isArray(posts) || posts.length === 0){
    posts = SEED_POSTS.slice();
    await savePosts();
  }
  return posts;
}
// Bổ sung lại các bài mẫu bị thiếu (theo slug) mà không xoá bài người dùng đã thêm/sửa
async function restoreMissingSeeds(){
  const arr = await loadPosts();
  const existingSlugs = new Set(arr.map(p=>p.slug));
  const missing = SEED_POSTS.filter(p=>!existingSlugs.has(p.slug));
  if(missing.length){
    posts = [...arr, ...missing];
    await savePosts();
  }
  return missing.length;
}
async function savePosts(){
  await POSTS_DOC.set({ items: posts });
}
async function getAuth(){
  try{
    const doc = await META_DOC.get();
    return (doc.exists && doc.data().passphrase) ? doc.data().passphrase : null;
  }catch(e){
    console.error('Không đọc được Firestore:', e);
    return null;
  }
}
async function setAuth(pass){
  await META_DOC.set({ passphrase: pass }, { merge:true });
}

let sessionUnlocked = false;

function fmtDate(iso){
  const d = new Date(iso + 'T00:00:00');
  return `${d.getDate()} tháng ${d.getMonth()+1}, ${d.getFullYear()}`;
}
function escapeHtml(s){
  return (s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function postcardHtml(p, index){
  const stampClass = p.published ? '' : ' draft-stamp';
  const stampText = p.published ? p.stamp : 'BẢN\nNHÁP';
  return `
  <a href="#/blog/${p.slug}" class="postcard" style="--tilt:${(index%2===0?-1:0.8)}deg">
    <div class="stamp${stampClass}">${escapeHtml(stampText).split('\n').join('<br>')}</div>
    <div class="post-date">${fmtDate(p.date)}</div>
    <h3 class="post-title">${escapeHtml(p.title)}</h3>
    <p class="post-excerpt">${escapeHtml(p.excerpt)}</p>
    <div class="post-tags">${p.tags.map(t=>`<span>${escapeHtml(t)}</span>`).join('')}</div>
  </a>`;
}
function setActiveNav(route){
  document.querySelectorAll('#navlinks a').forEach(a=>{
    a.classList.toggle('active', a.dataset.route===route);
  });
}

async function renderHomePage(){
  setActiveNav('');
  const all = (await loadPosts()).filter(p=>p.published).sort((a,b)=>b.date.localeCompare(a.date));
  const recent = all.slice(0,3);
  document.getElementById('app').innerHTML = `
    <header class="hero">
      <span class="eyebrow">một góc yên tĩnh trên internet ⋆｡°✩</span>
      <h1>Nhật ký của<br>một đứa <span class="accent">hướng nội</span></h1>
      <p class="lede">
        Chào bạn, mình là Thành — dân QC ở Quảng Ninh, từng lăn lộn với IT ở Hà Nội một dạo.
