async function renderBlogList(){
  setActiveNav('blog');
  const all = (await loadPosts()).filter(p=>p.published).sort((a,b)=>b.date.localeCompare(a.date));
  document.getElementById('app').innerHTML = `
    <header class="hero" style="padding:56px 0 32px;">
      <span class="eyebrow">tất cả những lá thư đã gửi</span>
      <h1>Blog</h1>
    </header>
    <section style="border-top:none; padding-top:0;">
      <div class="posts-grid">
        ${all.length ? all.map(postcardHtml).join('') : '<p class="empty-note">Chưa có bài nào được đăng.</p>'}
      </div>
    </section>
    <footer>© 2026 — góc nhỏ của Thành.</footer>
  `;
}

async function renderBlogPost(slug){
  setActiveNav('blog');
  const all = await loadPosts();
  const p = all.find(x=>x.slug===slug);
  const app = document.getElementById('app');
  if(!p || (!p.published)){
    app.innerHTML = `
      <div style="padding:80px 0; text-align:center;">
        <h2>Không tìm thấy bài viết này</h2>
        <p style="color:var(--text-soft); margin-top:10px;">Có lẽ nó đã bị xoá, hoặc còn ở dạng bản nháp.</p>
        <a href="#/blog" class="back-link">← Quay lại Blog</a>
      </div>`;
    return;
  }
  const html = marked.parse(p.content || '');
  app.innerHTML = `
    <div style="padding:48px 0 24px;"><a href="#/blog" class="back-link">← Quay lại Blog</a></div>
    <article class="post-full">
      <div class="post-date">${fmtDate(p.date)}</div>
      <h1 class="post-full-title">${escapeHtml(p.title)}</h1>
      <div class="post-tags">${p.tags.map(t=>`<span>${escapeHtml(t)}</span>`).join('')}</div>
      <div class="post-body" style="margin-top:18px;">${html}</div>
    </article>
    <div style="padding:24px 0 60px;"><a href="#/blog" class="back-link">← Quay lại Blog</a></div>
  `;
  app.querySelectorAll('.post-body pre code').forEach(block=>hljs.highlightElement(block));
}

async function renderAdminGate(){
  setActiveNav('admin');
  const existing = await getAuth();
  const app = document.getElementById('app');
  if(!existing){
    app.innerHTML = `
      <div class="admin-gate">
        <span class="eyebrow">lần đầu ghé trang quản trị</span>
        <h2>Đặt mật khẩu quản trị</h2>
        <p style="color:var(--text-soft); font-size:.9rem; margin-top:8px;">
          Đây chỉ là một lớp khoá đơn giản phía trình duyệt, không phải xác thực máy chủ thật —
          đủ để người khác không bấm nhầm vào, chứ không bảo mật ở mức đăng nhập thật.
        </p>
        <input type="password" id="setpass" placeholder="Tạo một mật khẩu..." />
        <div style="margin-top:16px;"><button class="btn btn-primary" id="setpass-btn">Đặt mật khẩu & vào trang quản trị</button></div>
      </div>`;
    document.getElementById('setpass-btn').onclick = async ()=>{
      const val = document.getElementById('setpass').value.trim();
      if(!val) return;
      await setAuth(val);
      sessionUnlocked = true;
      renderRoute();
    };
  } else {
    app.innerHTML = `
      <div class="admin-gate">
        <span class="eyebrow">chỉ mình mới được vào đây thôi nhé</span>
        <h2>Nhập mật khẩu quản trị</h2>
        <input type="password" id="pass" placeholder="Mật khẩu..." />
        <div style="margin-top:16px;"><button class="btn btn-primary" id="pass-btn">Vào trang quản trị</button></div>
        <p id="pass-error" style="color:var(--danger); font-size:.85rem; margin-top:10px; display:none;">Sai mật khẩu rồi, thử lại xem ٩(◞ ‸ ◟)۶</p>
      </div>`;
    const tryLogin = async ()=>{
      const val = document.getElementById('pass').value;
      if(val === existing){ sessionUnlocked = true; renderRoute(); }
      else { document.getElementById('pass-error').style.display='block'; }
    };
    document.getElementById('pass-btn').onclick = tryLogin;
    document.getElementById('pass').addEventListener('keydown', e=>{ if(e.key==='Enter') tryLogin(); });
  }
}

async function renderAdminDashboard(){
  setActiveNav('admin');
  const all = (await loadPosts()).slice().sort((a,b)=>b.date.localeCompare(a.date));
  document.getElementById('app').innerHTML = `
    <header class="hero" style="padding:56px 0 32px;">
      <span class="eyebrow">bàn làm việc riêng</span>
      <h1>Quản trị blog</h1>
    </header>
    <section style="border-top:none; padding-top:0;">
      <div class="admin-header">
        <h2 style="margin:0;">Tất cả bài viết (${all.length})</h2>
        <div style="display:flex; gap:10px;">
          <button class="btn btn-ghost btn-sm" id="restore-btn">Khôi phục bài mẫu bị thiếu</button>
          <button class="btn btn-primary" id="new-post-btn">+ Bài viết mới</button>
        </div>
      </div>
      <div class="admin-list">
        ${all.length ? all.map(p=>`
          <div class="admin-row" data-slug="${p.slug}">
            <div class="admin-row-main">
              <div class="admin-row-title">${escapeHtml(p.title)}
                <span class="badge ${p.published?'badge-live':'badge-draft'}">${p.published?'đã đăng':'bản nháp'}</span>
              </div>
              <div class="admin-row-meta">${fmtDate(p.date)} · /blog/${p.slug}</div>
            </div>
            <div class="admin-row-actions">
              <button class="btn btn-ghost btn-sm edit-btn" data-slug="${p.slug}">Sửa</button>
              <button class="btn btn-danger btn-sm delete-btn" data-slug="${p.slug}">Xoá</button>
            </div>
          </div>
        `).join('') : '<p class="empty-note">Chưa có bài viết nào. Bấm "+ Bài viết mới" để bắt đầu.</p>'}
      </div>
    </section>
    <footer>© 2026 — trang quản trị riêng của Thành.</footer>
  `;
  document.getElementById('new-post-btn').onclick = ()=>{ location.hash = '#/admin/new'; };
  document.getElementById('restore-btn').onclick = async ()=>{
    const n = await restoreMissingSeeds();
    alert(n ? `Đã khôi phục ${n} bài mẫu bị thiếu.` : 'Không thiếu bài mẫu nào cả.');
    renderAdminDashboard();
  };
  document.querySelectorAll('.edit-btn').forEach(b=>{ b.onclick = ()=>{ location.hash = '#/admin/edit/' + b.dataset.slug; }; });
  document.querySelectorAll('.delete-btn').forEach(b=>{
    b.onclick = async ()=>{
      const slug = b.dataset.slug;
      const row = document.querySelector(`.admin-row[data-slug="${slug}"]`);
      const title = row.querySelector('.admin-row-title').textContent.trim();
      if(confirm(`Xoá bài "${title}"? Không thể hoàn tác.`)){
        posts = (await loadPosts()).filter(p=>p.slug!==slug);
        await savePosts();
        renderAdminDashboard();
      }
    };
  });
}

async function renderEditor(slugParam){
  setActiveNav('admin');
  const all = await loadPosts();
  const isNew = !slugParam;
  const existing = isNew ? null : all.find(p=>p.slug===slugParam);
  const p = existing || { slug:'', date:new Date().toISOString().slice(0,10), title:'', excerpt:'', tags:[], stamp:'GHI\nCHÚ', published:false, content:'' };

  document.getElementById('app').innerHTML = `
    <header class="hero" style="padding:56px 0 24px;">
      <span class="eyebrow">${isNew?'viết một lá thư mới':'chỉnh sửa'}</span>
      <h1>${isNew?'Bài viết mới':'Sửa bài viết'}</h1>
    </header>
    <section style="border-top:none; padding-top:0;">
      <div class="editor-grid">
        <div style="display:flex; flex-direction:column; gap:14px;">
          <div class="field">
            <label>Tiêu đề</label>
            <input type="text" id="f-title" value="${escapeHtml(p.title)}" placeholder="Tiêu đề bài viết..." />
          </div>
          <div class="field">
            <label>Slug (đường dẫn /blog/...)</label>
            <input type="text" id="f-slug" value="${escapeHtml(p.slug)}" placeholder="tu-dong-tao-tu-tieu-de" />
          </div>
          <div class="field">
            <label>Ngày đăng</label>
            <input type="date" id="f-date" value="${p.date}" />
          </div>
          <div class="field">
            <label>Thẻ (cách nhau bởi dấu phẩy)</label>
            <input type="text" id="f-tags" value="${escapeHtml(p.tags.join(', '))}" placeholder="FGO, thần thoại" />
          </div>
          <div class="field field-excerpt">
            <label>Tóm tắt ngắn (hiện ở thẻ bưu thiếp)</label>
            <textarea id="f-excerpt" placeholder="Một hoặc hai câu giới thiệu...">${escapeHtml(p.excerpt)}</textarea>
          </div>
          <div class="field field-content">
            <label>Nội dung (Markdown)</label>
            <textarea id="f-content" placeholder="# Viết ở đây bằng Markdown...">${escapeHtml(p.content)}</textarea>
          </div>
          <div class="field field-checkbox">
            <input type="checkbox" id="f-published" ${p.published?'checked':''} style="width:16px;height:16px;" />
            <label style="margin:0;" for="f-published">Đăng công khai (bỏ chọn = lưu ở dạng bản nháp)</label>
          </div>
          <div class="editor-actions">
            <button class="btn btn-primary" id="save-btn">Lưu bài viết</button>
            <button class="btn btn-ghost" id="cancel-btn">Huỷ</button>
            <span class="save-note" id="save-note">Đã lưu ✓</span>
          </div>
        </div>
        <div>
          <span class="preview-label">xem trước</span>
          <div class="preview-pane" id="preview-pane"></div>
        </div>
      </div>
    </section>
    <footer>© 2026 — trang quản trị riêng của Thành.</footer>
  `;

  const titleEl = document.getElementById('f-title');
  const slugEl = document.getElementById('f-slug');
  const contentEl = document.getElementById('f-content');
  const previewEl = document.getElementById('preview-pane');
  let slugTouched = !isNew;

  function updatePreview(){
    previewEl.innerHTML = marked.parse(contentEl.value || '*Nội dung xem trước sẽ hiện ở đây...*');
    previewEl.querySelectorAll('pre code').forEach(b=>hljs.highlightElement(b));
  }
  updatePreview();
  contentEl.addEventListener('input', updatePreview);
  titleEl.addEventListener('input', ()=>{ if(!slugTouched) slugEl.value = slugify(titleEl.value); });
  slugEl.addEventListener('input', ()=>{ slugTouched = slugEl.value.trim().length>0; });
  document.getElementById('cancel-btn').onclick = ()=>{ location.hash = '#/admin'; };

  document.getElementById('save-btn').onclick = async ()=>{
    const newSlug = slugify(slugEl.value || titleEl.value);
    if(!newSlug || !titleEl.value.trim()){ alert('Cần có tiêu đề (và slug) trước khi lưu.'); return; }
    const dupExists = all.some(x=>x.slug===newSlug && x.slug!==p.slug);
    if(dupExists){ alert('Slug này đã được dùng cho bài khác — hãy đổi slug.'); return; }
    const updated = {
      slug:newSlug, title:titleEl.value.trim(),
      date:document.getElementById('f-date').value || p.date,
      tags:document.getElementById('f-tags').value.split(',').map(t=>t.trim()).filter(Boolean),
      excerpt:document.getElementById('f-excerpt').value.trim(),
      content:contentEl.value,
      published:document.getElementById('f-published').checked,
      stamp:p.stamp || 'GHI\nCHÚ'
    };
    let arr = await loadPosts();
    arr = existing ? arr.map(x=>x.slug===p.slug ? updated : x) : [...arr, updated];
    posts = arr;
    await savePosts();
    document.getElementById('save-note').classList.add('show');
    setTimeout(()=>{ location.hash = '#/admin'; }, 500);
  };
}

async function renderRoute(){
  const hash = location.hash || '#/';
  const parts = hash.replace(/^#\//,'').split('/').filter(Boolean);
  if(parts[0] === 'admin'){
    if(!sessionUnlocked){ await renderAdminGate(); return; }
    if(parts[1]==='new'){ await renderEditor(null); return; }
    if(parts[1]==='edit' && parts[2]){ await renderEditor(parts[2]); return; }
    await renderAdminDashboard();
    return;
  }
  if(parts[0] === 'blog'){
    if(parts[1]){ await renderBlogPost(parts[1]); return; }
    await renderBlogList();
    return;
  }
  await renderHomePage();
}

window.addEventListener('hashchange', renderRoute);
window.addEventListener('DOMContentLoaded', ()=>{
  const starsEl = document.getElementById('stars');
  for(let i=0;i<40;i++){
    const s = document.createElement('div');
    s.className='star';
    s.style.left = Math.random()*100+'%';
    s.style.top = Math.random()*60+'%';
    s.style.animationDelay = (Math.random()*4)+'s';
    starsEl.appendChild(s);
  }
  renderRoute();
});
</script>
