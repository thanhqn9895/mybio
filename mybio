<script>
/* ===================== FIREBASE SETUP =====================
   1. Vào https://console.firebase.google.com -> Tạo project mới (free) -> Build -> Firestore Database -> Create database -> chọn "Start in test mode" (tạm thời, sẽ khoá lại rules sau).
   2. Vào Project settings (icon bánh răng) -> General -> mục "Your apps" -> bấm biểu tượng </> để tạo Web App -> copy đoạn firebaseConfig -> dán đè vào bên dưới.
   3. Vào Firestore -> tab Rules -> dán rules gợi ý bên dưới (trong phần hướng dẫn deploy) rồi Publish.
============================================================= */
const firebaseConfig = {
  apiKey: "DÁN_API_KEY_CỦA_BẠN_VÀO_ĐÂY",
  authDomain: "ten-project.firebaseapp.com",
  projectId: "ten-project",
  storageBucket: "ten-project.appspot.com",
  messagingSenderId: "000000000000",
  appId: "1:000000000000:web:xxxxxxxxxxxxxxxx"
};
firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();
const POSTS_DOC = db.collection('blog').doc('posts');
const META_DOC = db.collection('blog').doc('meta');

const SEED_POSTS = [
  {
    slug: 'viet-thu-tay-thoi-so-hoa',
    date: '2026-08-14',
    title: 'Viết thư tay thời số hoá — vì sao mình vẫn thích Slowly',
    excerpt: 'Có lẽ vì phải chờ vài ngày một lá thư mới bay tới, mỗi câu chữ tự nhiên trở nên đáng cân nhắc hơn.',
    tags: ['Slowly', 'hướng nội'],
    stamp: 'GÓC\nNHỎ',
    published: true,
    content: "Có lẽ vì phải chờ vài ngày một lá thư mới bay tới, mỗi câu chữ tự nhiên trở nên đáng cân nhắc hơn — không phải kiểu \"seen\" rồi lướt qua như tin nhắn thường.\n\n## Vì sao chậm lại là một tính năng\n\nMình nghĩ Slowly hay ở chỗ nó *giả lập* độ trễ của thư tay thật. Bạn viết, gửi đi, rồi... chờ. Trong lúc chờ, bạn không còn nghĩ về câu trả lời nữa — bạn nghĩ về người đang đọc nó.\n\n- Không có typing indicator để lo lắng\n- Không có áp lực trả lời ngay\n- Mỗi câu chữ được viết kỹ hơn một chút\n\nVới một đứa hướng nội như mình, đây gần như là môi trường lý tưởng để kết nối — sâu nhưng không ngộp.\n\n> Chờ đợi đôi khi lại là phần hay nhất.\n\nMình đang viết thư cho hai người bạn hiện tại, mỗi người một kiểu hoàn toàn khác nhau, và mình thấy chính cách viết của mình cũng thay đổi tuỳ người."
  },
  {
    slug: 'than-thoai-nhat-trong-fgo',
    date: '2026-08-06',
    title: 'Thần thoại Nhật trong FGO: Amaterasu không chỉ là một Servant 5 sao',
    excerpt: 'Mỗi lần roll banner mới, mình lại mất nguyên buổi tối đọc lore gốc.',
    tags: ['FGO', 'thần thoại'],
    stamp: '研究\nノート',
    published: true,
    content: "Mỗi lần roll banner mới, mình lại mất nguyên buổi tối đọc lore gốc thay vì đi farm material — thói quen xấu nhưng vui.\n\n## Amaterasu và Susanoo\n\nTrong thần thoại gốc (Kojiki), mối quan hệ giữa hai vị thần này phức tạp hơn nhiều so với những gì một dòng thoại trong game có thể truyền tải.\n\n1. Amaterasu — nữ thần mặt trời, tổ tiên của hoàng gia Nhật\n2. Susanoo — vị thần bão tố, vừa là em vừa là kẻ phá bĩnh vĩnh viễn\n3. Cuộc rút lui vào hang đá — phân đoạn được nhắc lại nhiều nhất trong văn hoá đại chúng Nhật\n\nĐây cũng là lý do mình thích FGO hơn nhiều game gacha khác: nó không dùng thần thoại như một cái skin đẹp, mà thật sự cố gắng đối thoại với nguồn gốc."
  },
  {
    slug: 'playlist-mot-minh-fujii-kaze',
    date: '2026-07-29',
