<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<style>
  :root{
    --ink-night:#1B2340; --ink-night-2:#232B4D; --ink-night-3:#2C3560;
    --paper:#F4EEDF; --paper-dim:#EAE2CC;
    --amber:#E3A857; --coral:#E8927C; --sage:#8FA998;
    --line:rgba(244,238,223,0.14); --text-soft:rgba(244,238,223,0.72);
    --danger:#D97D6E;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{background:var(--ink-night); color:var(--paper); font-family:'Be Vietnam Pro',sans-serif; line-height:1.6;}
  body::before{content:"";position:fixed;inset:0;
    background-image:radial-gradient(circle at 15% 20%, rgba(227,168,87,0.06), transparent 40%),
                      radial-gradient(circle at 85% 75%, rgba(232,146,124,0.05), transparent 45%);
    pointer-events:none; z-index:0;}
  .stars{position:fixed;inset:0;z-index:0;pointer-events:none;}
  .star{position:absolute;width:2px;height:2px;background:var(--paper);border-radius:50%;opacity:.5;animation:twinkle 4s ease-in-out infinite;}
  @keyframes twinkle{0%,100%{opacity:.15;}50%{opacity:.7;}}
  @media (prefers-reduced-motion: reduce){ .star,.kalimba-divider span{animation:none;} }

  .wrap{max-width:760px;margin:0 auto;padding:0 24px;position:relative;z-index:1;}

  nav.topnav{
    position:sticky; top:0; z-index:10;
    background:rgba(27,35,64,0.88); backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  nav.topnav .wrap{display:flex; align-items:center; justify-content:space-between; padding:14px 24px;}
  .brand{font-family:'Shippori Mincho',serif; font-weight:600; font-size:1.05rem; color:var(--paper); text-decoration:none;}
  .navlinks{display:flex; gap:18px; font-size:0.92rem;}
  .navlinks a{color:var(--text-soft); text-decoration:none; border-bottom:1px solid transparent; padding-bottom:2px;}
  .navlinks a:hover, .navlinks a.active{color:var(--amber); border-color:var(--amber);}

  header.hero{padding:64px 0 48px;}
  .eyebrow{font-family:'Caveat',cursive; font-size:1.35rem; color:var(--amber); display:inline-block; transform:rotate(-2deg); margin-bottom:6px;}
  h1{font-family:'Shippori Mincho',serif; font-weight:800; font-size:clamp(2.1rem,6vw,3.3rem); line-height:1.25;}
  h1 .accent{color:var(--coral);}
  .lede{margin-top:18px; max-width:56ch; color:var(--text-soft); font-size:1.02rem;}
  .kalimba-divider{display:flex; gap:6px; margin:28px 0 0;}
  .kalimba-divider span{width:9px;height:26px;border-radius:3px;background:linear-gradient(180deg,var(--amber),rgba(227,168,87,.3));animation:key-bounce 2.6s ease-in-out infinite;}
  .kalimba-divider span:nth-child(2){animation-delay:.15s;height:18px;}
  .kalimba-divider span:nth-child(3){animation-delay:.3s;height:32px;}
  .kalimba-divider span:nth-child(4){animation-delay:.45s;height:14px;}
  .kalimba-divider span:nth-child(5){animation-delay:.6s;height:22px;}
  .kalimba-divider span:nth-child(6){animation-delay:.75s;height:20px;}
  .kalimba-divider span:nth-child(7){animation-delay:.9s;height:28px;}
  @keyframes key-bounce{0%,100%{transform:translateY(0);}50%{transform:translateY(-4px);}}

  section{padding:48px 0; border-top:1px solid var(--line); position:relative; z-index:1;}
  .section-label{font-family:'Caveat',cursive; color:var(--sage); font-size:1.2rem; margin-bottom:12px; transform:rotate(-1deg); display:inline-block;}
  h2{font-family:'Shippori Mincho',serif; font-size:1.6rem; margin-bottom:16px;}
  .tag-row{display:flex; flex-wrap:wrap; gap:8px; margin-top:18px;}
  .tag{font-size:0.85rem; padding:6px 14px; border-radius:20px; border:1px solid var(--line); background:rgba(244,238,223,0.04);}

  .posts-grid{display:flex; flex-direction:column; gap:24px; margin-top:8px;}
  .postcard{
    background:var(--paper); color:#2A2416; border-radius:3px; padding:24px 24px 20px;
    position:relative; box-shadow:0 14px 30px rgba(0,0,0,0.28);
    transform:rotate(var(--tilt,-1deg)); transition:transform .25s ease, box-shadow .25s ease;
    text-decoration:none; display:block; cursor:pointer;
  }
  .posts-grid .postcard:nth-child(2){--tilt:0.8deg;}
  .posts-grid .postcard:nth-child(3){--tilt:-0.6deg;}
  .posts-grid .postcard:nth-child(4){--tilt:0.5deg;}
  .postcard:hover{transform:rotate(0deg) translateY(-3px); box-shadow:0 20px 38px rgba(0,0,0,.34);}
  .stamp{position:absolute; top:16px; right:18px; width:52px; height:62px; border:2px dashed rgba(42,36,22,.35);
    display:flex; align-items:center; justify-content:center; font-family:'Shippori Mincho',serif; font-size:.65rem;
    text-align:center; line-height:1.2; color:rgba(42,36,22,.55); transform:rotate(4deg);}
  .draft-stamp{border-color:rgba(217,125,110,.6); color:var(--danger);}
  .post-date{font-family:'Caveat',cursive; font-size:1.1rem; color:var(--coral);}
  .post-title{font-family:'Shippori Mincho',serif; font-size:1.25rem; margin:6px 0 8px; padding-right:60px; color:#2A2416;}
  .post-excerpt{font-size:.95rem; color:#4A4230;}
  .post-tags{margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;}
  .post-tags span{font-size:.7rem; padding:3px 10px; border-radius:20px; background:rgba(42,36,22,.08); color:#4A4230;}
  .empty-note{color:var(--text-soft); font-style:italic;}

  .post-full{background:var(--paper); color:#2A2416; border-radius:6px; padding:32px 28px; box-shadow:0 14px 30px rgba(0,0,0,.28); margin-top:8px;}
  .post-full .post-date{font-size:1.2rem;}
  .post-full h1.post-full-title{font-family:'Shippori Mincho',serif; font-size:1.8rem; margin:8px 0 18px; color:#2A2416; line-height:1.3;}
  .post-body{font-size:1rem; color:#332C1E;}
  .post-body p{margin-bottom:14px;}
  .post-body h2, .post-body h3{font-family:'Shippori Mincho',serif; margin:22px 0 10px; color:#2A2416;}
  .post-body ul, .post-body ol{margin:0 0 14px 22px;}
  .post-body a{color:#B5652F;}
  .post-body pre{border-radius:8px; padding:16px; overflow-x:auto; margin:16px 0; font-family:'JetBrains Mono',monospace; font-size:.85rem;}
  .post-body code{font-family:'JetBrains Mono',monospace; font-size:.85em;}
  .post-body p code{background:rgba(42,36,22,.08); padding:2px 6px; border-radius:4px;}
  .back-link{display:inline-block; margin-top:22px; color:var(--text-soft); text-decoration:none; font-size:.9rem;}
  .back-link:hover{color:var(--amber);}

  .letterbox{border:1px solid var(--line); border-radius:6px; padding:24px; background:rgba(244,238,223,.03);}
  .letterbox p{color:var(--text-soft); margin-bottom:12px;}
  .sign-off{font-family:'Caveat',cursive; font-size:1.35rem; color:var(--amber); margin-top:16px; display:block;}

  footer{padding:36px 0 50px; text-align:center; color:rgba(244,238,223,.4); font-size:.82rem;}

  .admin-gate{max-width:380px; margin:80px auto; text-align:center;}
  .admin-gate input{width:100%; padding:12px 14px; border-radius:6px; border:1px solid var(--line); background:var(--ink-night-2); color:var(--paper); font-size:1rem; margin-top:16px;}
  .admin-header{display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:24px;}
  .btn{display:inline-flex; align-items:center; gap:6px; cursor:pointer; border:none; border-radius:6px;
    padding:10px 18px; font-family:'Be Vietnam Pro',sans-serif; font-size:.9rem; font-weight:500;}
  .btn-primary{background:var(--amber); color:#1B2340;}
  .btn-primary:hover{background:#eebb70;}
  .btn-ghost{background:transparent; color:var(--text-soft); border:1px solid var(--line);}
  .btn-ghost:hover{color:var(--paper); border-color:var(--paper);}
  .btn-danger{background:transparent; color:var(--danger); border:1px solid rgba(217,125,110,.4);}
  .btn-danger:hover{background:rgba(217,125,110,.12);}
  .btn-sm{padding:6px 12px; font-size:.8rem;}

  .admin-list{display:flex; flex-direction:column; gap:12px;}
  .admin-row{display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
    border:1px solid var(--line); border-radius:8px; padding:14px 16px; background:rgba(244,238,223,.03);}
  .admin-row-main{min-width:0;}
  .admin-row-title{font-weight:500; color:var(--paper); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
  .admin-row-meta{font-size:.8rem; color:var(--text-soft); margin-top:2px;}
  .badge{font-size:.68rem; padding:2px 8px; border-radius:20px; margin-left:8px; vertical-align:middle;}
  .badge-live{background:rgba(143,169,152,.2); color:var(--sage);}
  .badge-draft{background:rgba(217,125,110,.2); color:var(--danger);}
  .admin-row-actions{display:flex; gap:8px; flex-shrink:0;}

  .editor-grid{display:grid; grid-template-columns:1fr; gap:16px;}
  @media (min-width:860px){ .editor-grid{grid-template-columns:1fr 1fr;} }
  .field{display:flex; flex-direction:column; gap:6px;}
  .field label{font-size:.82rem; color:var(--text-soft);}
  .field input[type=text], .field input[type=date], .field textarea{
    background:var(--ink-night-2); border:1px solid var(--line); border-radius:6px; color:var(--paper);
    padding:10px 12px; font-family:'Be Vietnam Pro',sans-serif; font-size:.92rem;}
  .field textarea{font-family:'JetBrains Mono',monospace; font-size:.85rem; resize:vertical;}
  .field-content textarea{min-height:320px;}
  .field-excerpt textarea{min-height:70px;}
  .field-checkbox{flex-direction:row; align-items:center; gap:8px;}
  .preview-pane{background:var(--paper); color:#2A2416; border-radius:6px; padding:20px; overflow-y:auto; max-height:520px;}
  .preview-pane pre{border-radius:8px; padding:14px; overflow-x:auto; font-family:'JetBrains Mono',monospace; font-size:.8rem;}
  .preview-label{font-family:'Caveat',cursive; color:var(--sage); font-size:1.1rem; margin-bottom:8px; display:block;}
  .editor-actions{display:flex; gap:10px; margin-top:20px; flex-wrap:wrap; align-items:center;}
  .save-note{font-size:.82rem; color:var(--sage); opacity:0; transition:opacity .3s;}
  .save-note.show{opacity:1;}
</style>
</head>
